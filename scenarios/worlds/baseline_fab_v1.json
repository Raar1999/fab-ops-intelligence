    {"name": "INSP-01", "tool_type": "INSPECTION", "vendor": "KLA",
     "install_date": "2021-10-19", "location_bay": "BAY-7",
     "operations": ["INSPECTION"],
     "chambers": [{"name": "A"}]},

    {"name": "TEST-01", "tool_type": "TEST", "vendor": "Teradyne",
     "install_date": "2021-12-06", "location_bay": "BAY-8",
     "operations": ["TEST"],
     "chambers": [{"name": "A"}]}
  ],

  "operators": [
    {"name": "OP-101", "shift": "A", "certification_level": "SENIOR"},
    {"name": "OP-102", "shift": "A", "certification_level": "QUALIFIED"},
    {"name": "OP-103", "shift": "A", "certification_level": "TRAINEE"},
    {"name": "OP-104", "shift": "B", "certification_level": "SENIOR"},
    {"name": "OP-105", "shift": "B", "certification_level": "QUALIFIED"},
    {"name": "OP-106", "shift": "B", "certification_level": "QUALIFIED"},
    {"name": "OP-107", "shift": "C", "certification_level": "SENIOR"},
    {"name": "OP-108", "shift": "C", "certification_level": "QUALIFIED"},
    {"name": "OP-109", "shift": "C", "certification_level": "TRAINEE"}
  ],

  "routing": {
    "stickiness": 0.6,
    "dedications": []
  },

  "lot_release": {
    "first_release_day": 0.25,
    "mean_interval_days": 4.0,
    "jitter_days": 1.2
  },

  "queue": {
    "delay_minutes": {"mean": 720.0, "sd": 260.0, "min": 60.0}
  },

  "maintenance": {
    "pm_interval_days": 30.0,
    "pm_jitter_days": 4.0,
    "pm_duration_hours": {"min": 2.0, "max": 6.0},
    "qual_duration_hours": 1.5,
    "breakdown_mtbf_days": 40.0,
    "breakdown_duration_hours": {"min": 1.0, "max": 8.0},
    "technicians": ["TECH-01", "TECH-02", "TECH-03", "TECH-04", "TECH-05"],
    "pm_action_codes": ["PM_WET_CLEAN", "PM_KIT_CHANGE", "PM_PREVENTIVE_CHECK",
                        "PM_CALIBRATION"],
    "unscheduled_action_codes": ["REPLACE_PART", "ADJUST_SUBSYSTEM",
                                 "CLEAN_AND_RESTART", "SEAL_REPLACE",
                                 "RECALIBRATE"]
  },

  "observation": {
    "latents": ["edge_uniformity", "param_bias", "particle_load"],

    "wafer_zones": ["center", "mid", "edge"],

    "variation_stack": {
      "run_noise": 1.0,
      "lot_ar1_phi": 0.6,
      "lot_ar1_sd": 0.55,
      "chamber_offset": 0.45,
      "tool_offset": 0.33,
      "fab_week": 0.33,
      "metrology_noise": 0.33
    },

    "severity_calibration": {"subtle": 1.5, "moderate": 3.0, "obvious": 6.0},

    "channels": [
      {"name": "chamber_pressure_mtorr", "kind": "fdc", "unit": "mtorr",
       "operation_types": ["ETCH", "CVD", "PVD"], "scale": 0.35,
       "sensitivities": {"param_bias": 0.35, "particle_load": 0.12,
                         "edge_uniformity": 0.05}},

      {"name": "rf_power_w", "kind": "fdc", "unit": "W",
       "operation_types": ["ETCH", "CVD"], "scale": 6.0,
       "sensitivities": {"param_bias": 0.2, "edge_uniformity": 0.08}},

      {"name": "gas_flow_sccm", "kind": "fdc", "unit": "sccm",
       "operation_types": ["ETCH"], "scale": 1.2,
       "sensitivities": {"param_bias": 1.0}},

      {"name": "endpoint_time_s", "kind": "fdc", "unit": "s",
       "operation_types": ["ETCH"], "scale": 1.1,
       "sensitivities": {"param_bias": 0.45, "edge_uniformity": 0.3}},

      {"name": "sih4_flow_sccm", "kind": "fdc", "unit": "sccm",
       "operation_types": ["CVD"], "scale": 2.5,
       "sensitivities": {"param_bias": 1.0}},

      {"name": "deposition_time_s", "kind": "fdc", "unit": "s",
       "operation_types": ["CVD", "PVD"], "scale": 1.8,
       "sensitivities": {"param_bias": 0.4, "particle_load": 0.1}},

      {"name": "dc_power_w", "kind": "fdc", "unit": "W",
       "operation_types": ["PVD"], "scale": 45.0,
       "sensitivities": {"param_bias": 0.25}},

      {"name": "down_force_psi", "kind": "fdc", "unit": "psi",
       "operation_types": ["CMP"], "scale": 0.06,
       "sensitivities": {"param_bias": 0.5, "particle_load": 0.15}},

      {"name": "exposure_dose_mj", "kind": "fdc", "unit": "mJ",
       "operation_types": ["LITHO"], "scale": 0.25,
       "sensitivities": {"param_bias": 0.6}},

      {"name": "temperature_c", "kind": "fdc", "unit": "C",
       "operation_types": ["FURNACE"], "scale": 1.5,
       "sensitivities": {"param_bias": 0.5}},

      {"name": "cd_nm", "kind": "metrology", "unit": "nm",
       "operation_types": ["ETCH"], "scale": 0.45,
       "sensitivities": {"edge_uniformity": 1.0, "param_bias": 0.85}}
    ],

    "classifier": {
      "classes": ["PARTICLE", "SCRATCH", "PATTERN", "RESIDUE", "OTHER"],
      "origins": ["uniform", "edge_ring", "center", "particle_cluster",
                  "scratch"],
      "confusion": {
        "uniform":          {"PARTICLE": 0.52, "PATTERN": 0.18,
                             "RESIDUE": 0.16, "SCRATCH": 0.04, "OTHER": 0.1},
        "edge_ring":        {"PATTERN": 0.62, "RESIDUE": 0.18,
                             "PARTICLE": 0.12, "OTHER": 0.08},
        "center":           {"PATTERN": 0.55, "PARTICLE": 0.2,
                             "RESIDUE": 0.15, "OTHER": 0.1},
        "particle_cluster": {"PARTICLE": 0.88, "RESIDUE": 0.05,
                             "PATTERN": 0.03, "SCRATCH": 0.02, "OTHER": 0.02},
        "scratch":          {"SCRATCH": 0.86, "PATTERN": 0.06,
                             "PARTICLE": 0.04, "OTHER": 0.04}
      }
    }
  },

  "alarms": {
    "severities": ["INFO", "WARNING", "CRITICAL"],
    "background_rate_per_chamber_day": 0.033,
    "detection_probability": 0.55,
    "codes": [
      {"code": "PRESSURE_HI", "source": "channel",
       "signal": "chamber_pressure_mtorr",
       "operation_types": ["ETCH", "CVD", "PVD"],
       "threshold_sigma": 3.0, "severity": "WARNING",
       "message": "chamber pressure outside its control limit"},

      {"code": "RF_REFLECT", "source": "channel", "signal": "rf_power_w",
       "operation_types": ["ETCH", "CVD"],
       "threshold_sigma": 3.0, "severity": "WARNING",
       "message": "reflected RF power outside its control limit"},

      {"code": "MFC_DEV", "source": "channel", "signal": "gas_flow_sccm",
       "operation_types": ["ETCH"],
       "threshold_sigma": 2.5, "severity": "WARNING",
       "message": "delivered gas flow deviates from setpoint"},

      {"code": "ENDPOINT_DEV", "source": "channel",
       "signal": "endpoint_time_s", "operation_types": ["ETCH"],
       "threshold_sigma": 3.0, "severity": "WARNING",
       "message": "endpoint detection time outside its control limit"},

      {"code": "DEPO_RATE_DEV", "source": "channel",
       "signal": "deposition_time_s", "operation_types": ["CVD", "PVD"],
       "threshold_sigma": 3.0, "severity": "INFO",
       "message": "deposition time outside its control limit"},

      {"code": "CMP_FORCE_DEV", "source": "channel",
       "signal": "down_force_psi", "operation_types": ["CMP"],
       "threshold_sigma": 3.0, "severity": "INFO",
       "message": "polish down force outside its control limit"},

      {"code": "DOSE_DEV", "source": "channel", "signal": "exposure_dose_mj",
       "operation_types": ["LITHO"],
       "threshold_sigma": 3.0, "severity": "INFO",
       "message": "exposure dose outside its control limit"},

      {"code": "TEMP_DEV", "source": "channel", "signal": "temperature_c",
       "operation_types": ["FURNACE"],
       "threshold_sigma": 3.0, "severity": "WARNING",
       "message": "process temperature outside its control limit"},

      {"code": "PARTICLE_HI", "source": "latent", "signal": "particle_load",
       "operation_types": ["ETCH", "CVD", "PVD", "CMP"],
       "threshold_sigma": 3.0, "severity": "CRITICAL",
       "message": "in-situ particle count above the clean threshold"},

      {"code": "UNIFORMITY_DEV", "source": "latent",
       "signal": "edge_uniformity", "operation_types": ["ETCH", "CVD", "PVD"],
       "threshold_sigma": 3.5, "severity": "WARNING",
       "message": "across-wafer uniformity outside its control limit"}
    ]
  },

  "die_grid": {
    "edge_exclusion_mm": 3.0,
    "street_width_mm": 0.08,
    "die_aspect_ratio": 1.0,
    "origin": "wafer_center",
    "index_order": "row_major",
    "partial_die_policy": "exclude"
  }
}
