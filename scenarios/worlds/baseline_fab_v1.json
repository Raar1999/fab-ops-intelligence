{
  "fabsim": "world/v1",
  "name": "baseline_fab_v1",
  "description": "The neutral Phase 1 fab: six products on one 14-step subtractive-metal route, fifteen tools, twenty-four chambers. Nothing here is a fault, a suspect, or a tuned answer; scenarios add events on top of this world, and the null scenario is this world alone.",

  "time_origin": "2026-03-02T00:00:00",
  "wafers_per_lot": 25,

  "operation_types": ["FURNACE", "LITHO", "ETCH", "METROLOGY", "INSPECTION",
                      "IMPLANT", "CVD", "CMP", "PVD", "TEST"],

  "layers": ["GATE", "METAL"],

  "recipes": {"version": "1.0"},

  "products": [
    {"name": "Mobile-28",  "flow": "logic_baseline", "technology_node_nm": 28,
     "wafer_size_mm": 300, "die_size_mm2": 32.0, "target_yield_pct": 87.5,
     "mix_weight": 4, "metric_scale": 0.62},
    {"name": "Logic-14",   "flow": "logic_baseline", "technology_node_nm": 14,
     "wafer_size_mm": 300, "die_size_mm2": 24.0, "target_yield_pct": 84.0,
     "mix_weight": 3, "metric_scale": 0.34},
    {"name": "Auto-40",    "flow": "logic_baseline", "technology_node_nm": 40,
     "wafer_size_mm": 300, "die_size_mm2": 55.0, "target_yield_pct": 91.0,
     "mix_weight": 3, "metric_scale": 0.88},
    {"name": "Memory-22",  "flow": "logic_baseline", "technology_node_nm": 22,
     "wafer_size_mm": 300, "die_size_mm2": 68.0, "target_yield_pct": 86.0,
     "mix_weight": 3, "metric_scale": 0.48},
    {"name": "IoT-65",     "flow": "logic_baseline", "technology_node_nm": 65,
     "wafer_size_mm": 300, "die_size_mm2": 18.0, "target_yield_pct": 93.0,
     "mix_weight": 2, "metric_scale": 1.42},
    {"name": "Sensor-90",  "flow": "logic_baseline", "technology_node_nm": 90,
     "wafer_size_mm": 300, "die_size_mm2": 96.0, "target_yield_pct": 94.0,
     "mix_weight": 1, "metric_scale": 2.0}
  ],

  "process_steps": [
    {"name": "OXIDE_GROWTH", "operation_type": "FURNACE",
     "duration_minutes": {"mean": 35.0, "sd": 5.0, "min": 20.0},
     "metric": {"name": "ox_thickness_nm", "target": 8.0, "tolerance": 0.8},
     "settings": {"temperature_c": 950.0, "process_time_s": 1800.0,
                  "o2_flow_sccm": 400.0}},

    {"name": "GATE_LITHO", "operation_type": "LITHO",
     "duration_minutes": {"mean": 32.0, "sd": 4.0, "min": 20.0},
     "metric": {"name": "resist_cd_nm", "target": 52.0, "tolerance": 4.0},
     "settings": {"exposure_dose_mj": 28.0, "focus_offset_nm": 0.0,
                  "scan_speed_mm_s": 500.0}},

    {"name": "GATE_ETCH", "operation_type": "ETCH",
     "duration_minutes": {"mean": 26.0, "sd": 3.0, "min": 15.0},
     "metric": {"name": "cd_nm", "target": 45.0, "tolerance": 3.5},
     "settings": {"chamber_pressure_mtorr": 12.0, "rf_power_w": 850.0,
                  "gas_flow_sccm": 120.0, "endpoint_time_s": 95.0}},

    {"name": "GATE_CD_METROLOGY", "operation_type": "METROLOGY",
     "measures": "GATE_ETCH",
     "duration_minutes": {"mean": 14.0, "sd": 2.0, "min": 8.0},
     "settings": {"sites_per_wafer": 9.0, "spot_size_um": 5.0}},

    {"name": "POST_GATE_INSPECT", "operation_type": "INSPECTION",
     "is_inspection": true,
     "covers": ["OXIDE_GROWTH", "GATE_LITHO", "GATE_ETCH"],
     "layer": "GATE",
     "duration_minutes": {"mean": 18.0, "sd": 3.0, "min": 10.0},
     "settings": {"sensitivity_threshold_um": 0.12, "scan_area_mm2": 5000.0}},

    {"name": "SD_IMPLANT", "operation_type": "IMPLANT",
     "duration_minutes": {"mean": 22.0, "sd": 3.0, "min": 12.0},
     "settings": {"dose_ions_cm2": 3.0e15, "energy_kev": 25.0,
                  "tilt_deg": 7.0}},

    {"name": "ILD_DEPOSITION", "operation_type": "CVD",
     "duration_minutes": {"mean": 28.0, "sd": 4.0, "min": 16.0},
     "metric": {"name": "ild_thickness_nm", "target": 520.0,
                "tolerance": 40.0},
     "settings": {"chamber_pressure_mtorr": 2500.0, "rf_power_w": 600.0,
                  "sih4_flow_sccm": 320.0, "deposition_time_s": 240.0}},

    {"name": "ILD_CMP", "operation_type": "CMP",
     "duration_minutes": {"mean": 24.0, "sd": 3.0, "min": 14.0},
     "metric": {"name": "removal_nm", "target": 180.0, "tolerance": 20.0},
     "settings": {"down_force_psi": 4.2, "platen_rpm": 60.0,
                  "slurry_flow_ml_min": 180.0, "polish_time_s": 110.0}},

    {"name": "METAL_DEPOSITION", "operation_type": "PVD",
     "duration_minutes": {"mean": 26.0, "sd": 4.0, "min": 15.0},
     "metric": {"name": "metal_thickness_nm", "target": 420.0,
                "tolerance": 35.0},
     "settings": {"chamber_pressure_mtorr": 3.5, "dc_power_w": 12000.0,
                  "ar_flow_sccm": 45.0, "deposition_time_s": 130.0}},

    {"name": "METAL_LITHO", "operation_type": "LITHO",
     "duration_minutes": {"mean": 34.0, "sd": 4.0, "min": 20.0},
     "metric": {"name": "resist_cd_nm", "target": 70.0, "tolerance": 5.0},
     "settings": {"exposure_dose_mj": 31.0, "focus_offset_nm": 0.0,
                  "scan_speed_mm_s": 480.0}},

    {"name": "METAL_ETCH", "operation_type": "ETCH",
     "duration_minutes": {"mean": 30.0, "sd": 4.0, "min": 18.0},
     "metric": {"name": "cd_nm", "target": 62.0, "tolerance": 4.5},
     "settings": {"chamber_pressure_mtorr": 9.0, "rf_power_w": 780.0,
                  "gas_flow_sccm": 150.0, "endpoint_time_s": 110.0}},

    {"name": "METAL_CD_METROLOGY", "operation_type": "METROLOGY",
     "measures": "METAL_ETCH",
     "duration_minutes": {"mean": 14.0, "sd": 2.0, "min": 8.0},
     "settings": {"sites_per_wafer": 9.0, "spot_size_um": 5.0}},

    {"name": "POST_METAL_INSPECT", "operation_type": "INSPECTION",
     "is_inspection": true,
     "covers": ["ILD_DEPOSITION", "ILD_CMP", "METAL_DEPOSITION",
                "METAL_LITHO", "METAL_ETCH"],
     "layer": "METAL",
     "duration_minutes": {"mean": 18.0, "sd": 3.0, "min": 10.0},
     "settings": {"sensitivity_threshold_um": 0.15, "scan_area_mm2": 5000.0}},

    {"name": "FINAL_TEST", "operation_type": "TEST",
     "duration_minutes": {"mean": 20.0, "sd": 3.0, "min": 12.0},
     "settings": {"touchdowns": 4.0, "test_temperature_c": 25.0}}
  ],

  "process_flows": [
    {"name": "logic_baseline",
     "steps": ["OXIDE_GROWTH", "GATE_LITHO", "GATE_ETCH",
               "GATE_CD_METROLOGY", "POST_GATE_INSPECT", "SD_IMPLANT",
               "ILD_DEPOSITION", "ILD_CMP", "METAL_DEPOSITION",
               "METAL_LITHO", "METAL_ETCH", "METAL_CD_METROLOGY",
               "POST_METAL_INSPECT", "FINAL_TEST"]}
  ],

  "tools": [
